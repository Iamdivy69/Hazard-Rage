# .env.example — Hazard Rage (Postgres + Redis + React)

# Copy to .env — never commit real values. Fail-fast validation at boot.

# Backend
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# Postgres 16 + PostGIS (Docker)
DATABASE_URL=postgresql://hazard:hazard@localhost:5432/hazard_rage?schema=public

# Redis 7 (cache + rate-limit, ADR-008)
REDIS_URL=redis://localhost:6379
CACHE_TTL=60

# Auth
JWT_SECRET=change-me-min-32-chars
JWT_EXPIRES_IN=24h

# SMTP (Nodemailer, alert emails)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=change-me
ALERT_FROM_EMAIL=Hazard Rage <alerts@example.com>

# Uploads: local disk by default. In production (Render disk is ephemeral)
# set all three to store photos on Cloudinary (free tier) instead.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Frontend (Vite — prefix VITE_)
# frontend/.env: VITE_API_URL=http://localhost:4000/api/v1
